model CatalogAvailability {
  id                  BigInt                    @id @default(autoincrement())
  imdbId              String?                   @map("imdb_id") @db.VarChar(64)
  traktId             BigInt?                   @map("trakt_id")
  tmdbId              BigInt?                   @map("tmdb_id")
  mediaType           MediaType                 @map("media_type")
  providerName        String                    @map("provider_name") @db.VarChar(191)
  providerRegion      String                    @map("provider_region") @db.VarChar(8)
  providerType        ProviderType              @map("provider_type")
  providerUrl         String?                   @map("provider_url") @db.Text
  providerLogoUrl     String?                   @map("provider_logo_url") @db.Text
  source              CatalogAvailabilitySource
  sourceConfidence    SourceConfidence          @map("source_confidence")
  checkedAt           DateTime                  @default(now()) @map("checked_at")
  expiresAt           DateTime                  @map("expires_at")
  evidencePayloadHash String?                   @map("evidence_payload_hash") @db.VarChar(191)
  rawPayloadJson      Json?                     @map("raw_payload_json")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  @@unique([imdbId, traktId, providerName, providerRegion, providerType])
  @@index([imdbId, providerRegion])
  @@index([traktId, providerRegion])
  @@index([expiresAt])
  @@index([source, sourceConfidence])
  @@map("catalog_availability")
}

