{
  "name": "poplog-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-local-user.ts",
    "db:smoke": "tsx -r tsconfig-paths/register scripts/smoke-test-local-repositories.ts",
    "db:smoke:services": "tsx -r tsconfig-paths/register scripts/smoke-test-local-services.ts",
    "db:smoke:availability": "tsx -r tsconfig-paths/register scripts/smoke-test-availability-layer.ts",
    "availability:verify": "tsx -r tsconfig-paths/register -r dotenv/config scripts/verify-availability-titles.ts dotenv_config_path=.env.local",
    "availability:revalidate-negatives": "tsx -r tsconfig-paths/register -r dotenv/config scripts/revalidate-negative-availability.ts dotenv_config_path=.env.local",
    "db:smoke:library-state": "tsx -r tsconfig-paths/register scripts/smoke-test-library-state-flags.ts",
    "db:smoke:lists": "tsx -r tsconfig-paths/register scripts/smoke-test-lists.ts",
    "db:smoke:episode-progress": "tsx -r tsconfig-paths/register scripts/smoke-test-episode-progress.ts",
    "db:smoke:series-engine": "tsx -r tsconfig-paths/register scripts/smoke-test-series-engine.ts",
    "db:smoke:canonical-episodes": "tsx -r tsconfig-paths/register scripts/smoke-test-canonical-episode-sync.ts",
    "db:smoke:user-ratings": "tsx -r tsconfig-paths/register scripts/smoke-test-user-ratings.ts",
    "db:smoke:rating-aggregates": "tsx -r tsconfig-paths/register scripts/smoke-test-rating-aggregates.ts",
    "db:smoke:feedback": "tsx -r tsconfig-paths/register scripts/smoke-test-feedback.ts",
    "db:smoke:curadoria": "tsx -r tsconfig-paths/register scripts/smoke-test-curadoria.ts",
    "db:smoke:curadoria-state": "tsx -r tsconfig-paths/register scripts/smoke-test-curadoria-state.ts",
    "db:smoke:acompanhando": "tsx -r tsconfig-paths/register scripts/smoke-test-acompanhando.ts",
    "db:smoke:hero": "tsx -r tsconfig-paths/register scripts/smoke-test-hero.ts",
    "db:smoke:continuity": "tsx -r tsconfig-paths/register scripts/smoke-test-continuity.ts",
    "db:smoke:radar-agenda": "tsx -r tsconfig-paths/register scripts/smoke-test-radar-agenda.ts",
    "smoke:trakt-client": "tsx -r tsconfig-paths/register scripts/smoke-test-trakt-client.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "backfill:state": "npx tsx scripts/backfill-user-title-state.ts",
    "backfill:state:dry": "npx tsx scripts/backfill-user-title-state.ts --dry-run",
    "backfill:usernames": "tsx -r tsconfig-paths/register scripts/backfill-usernames.ts",
    "backfill:usernames:dry": "tsx -r tsconfig-paths/register scripts/backfill-usernames.ts --dry-run",
    "backfill:movie-duration": "npx tsx scripts/backfill-movie-duration.ts",
    "db:export": "tsx scripts/db/export-local-data.ts",
    "db:import": "tsx scripts/db/import-local-data.ts",
    "db:backup": "tsx scripts/db/backup-mysql.ts",
    "db:restore": "tsx scripts/db/restore-mysql.ts",
    "db:smoke:export-import": "tsx scripts/db/smoke-export-import.ts",
    "backfill:titles:dry": "tsx -r tsconfig-paths/register scripts/backfill-technical-titles.ts",
    "backfill:titles": "tsx -r tsconfig-paths/register scripts/backfill-technical-titles.ts --apply",
    "fix:media-type:dry": "tsx -r tsconfig-paths/register scripts/fix-media-type-mismatches.ts",
    "fix:media-type": "tsx -r tsconfig-paths/register scripts/fix-media-type-mismatches.ts --apply",
    "smoke:display-title": "tsx -r tsconfig-paths/register scripts/smoke-test-display-title.ts",
    "smoke:provider-normalization": "tsx -r tsconfig-paths/register scripts/smoke-test-provider-normalization.ts",
    "smoke:synthetic-id": "tsx -r tsconfig-paths/register scripts/smoke-test-synthetic-id.ts",
    "smoke:library-identity": "tsx -r tsconfig-paths/register scripts/smoke-test-library-identity.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "google-translate-api-x": "^10.7.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
