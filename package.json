{
  "name": "poplog-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-local-user.ts",
    "db:smoke": "tsx -r tsconfig-paths/register scripts/smoke-test-local-repositories.ts",
    "db:smoke:services": "tsx -r tsconfig-paths/register scripts/smoke-test-local-services.ts",
    "db:smoke:budget": "tsx -r tsconfig-paths/register scripts/smoke-test-premium-budget.ts",
    "db:smoke:availability": "tsx -r tsconfig-paths/register scripts/smoke-test-availability.ts",
    "db:smoke:library-state": "tsx -r tsconfig-paths/register scripts/smoke-test-library-state-flags.ts",
    "db:smoke:episode-progress": "tsx -r tsconfig-paths/register scripts/smoke-test-episode-progress.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "check:feedback-engine": "npx tsx scripts/check-feedback-engine.ts",
    "backfill:state": "npx tsx scripts/backfill-user-title-state.ts",
    "backfill:state:dry": "npx tsx scripts/backfill-user-title-state.ts --dry-run",
    "backfill:movie-duration": "npx tsx scripts/backfill-movie-duration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "google-translate-api-x": "^10.7.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
