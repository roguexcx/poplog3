DATABASE_URL="mysql://poplog:poplog_local_password@localhost:3306/poplog_v3"
LOCAL_USER_ID="local-user"

# Para ativar TODOS os módulos locais de uma vez, use .env.local.full.example como base.
# Ver: docs/LOCAL_FULL_MODE.md

# Flags de migracao local.
# POPLOG_LOCAL_DB_ENABLED ativa logs e caches locais de baixo risco juntos.
# As flags especificas podem ser usadas separadamente em testes.
POPLOG_LOCAL_DB_ENABLED=false
POPLOG_LOCAL_LOGS_ENABLED=false
POPLOG_LOCAL_CACHE_ENABLED=false
# Controla o roteamento de reserva/conclusao de budget premium (omdb/watchmode/movieofthenight)
# pelo adapter Prisma local em vez do Supabase.
POPLOG_LOCAL_API_USAGE_ENABLED=false
# Controla o roteamento de leitura/escrita de catalog availability pelo adapter Prisma local.
# Usa catalog_availability (chave: tmdbId + providerRegion + source).
# Campos nullificados localmente: deep_link, quality, provider_logo_path, tmdb_provider_id.
POPLOG_LOCAL_AVAILABILITY_ENABLED=false
# Fallback EXPERIMENTAL de disponibilidade via JustWatch GraphQL NÃO oficial.
# Desligado por padrão. Quando ligado, é consultado APENAS dentro de availability-service,
# como fallback controlado DEPOIS do Balloonerismm (fonte primária), e somente quando o
# Balloonerismm falha/retorna vazio para BR. Não é chamado em massa em listas/cards.
# Quando retorna providers, são gravados em catalog_availability com source "justwatch"
# (tag distinta) e TTL curto, para que os cards (cacheOnly) também exibam o badge.
# Trocar por fonte licenciada/Partner API mexe só na source isolada.
JUSTWATCH_UNOFFICIAL_FALLBACK=false
# Enriquecimento de canais/pacotes via JustWatch. Ativo por padrão: quando
# Balloonerismm/TMDB retorna um host genérico (ex.: Prime Video), tenta preservar
# o canal real (ex.: Diamond Films Amazon Channel). Use false/0/off/no para desligar.
JUSTWATCH_CHANNEL_ENRICHMENT=true
# Controla o roteamento de leitura/escrita de biblioteca pelo adapter Prisma local.
POPLOG_LOCAL_LIBRARY_ENABLED=false
# Controla o roteamento de leitura/escrita de user_title_state pelo adapter Prisma local.
POPLOG_LOCAL_USER_STATE_ENABLED=false
# Controla o roteamento de progresso de episodios/series pelo adapter Prisma local.
POPLOG_LOCAL_EPISODE_PROGRESS_ENABLED=false
# Controla o roteamento de ratings pessoais pelo adapter Prisma local.
POPLOG_LOCAL_USER_RATINGS_ENABLED=false
# Controla o roteamento de feedback/personalizacao pelo adapter Prisma local.
POPLOG_LOCAL_FEEDBACK_ENABLED=false
# Controla o roteamento de preferencias de curadoria pelo adapter Prisma local.
POPLOG_LOCAL_USER_PREFERENCES_ENABLED=false
# Controla o roteamento de preferencias de streaming pelo adapter Prisma local.
POPLOG_LOCAL_STREAMING_PREFERENCES_ENABLED=false
# Controla o roteamento de sinais/eventos basicos de curadoria pelo adapter Prisma local.
POPLOG_LOCAL_CURADORIA_ENABLED=false
# Controla o roteamento de user_curadoria_state pelo adapter Prisma local.
POPLOG_LOCAL_CURADORIA_STATE_ENABLED=false
# Ativa o GET completo de /api/poplog3/acompanhando usando dados locais Prisma/MySQL.
# Requer biblioteca local, titulo/episode cache, availability, curadoria state e preferencias locais.
POPLOG_LOCAL_ACOMPANHANDO_ENABLED=false
# Ativa o Hero Spotlight usando dados locais Prisma/MySQL (biblioteca, title cache, availability,
# curadoria state, impressoes em hero_spotlight_sessions).
POPLOG_LOCAL_HERO_ENABLED=false
# Ativa a seção "Continue de onde parou" usando dados locais (user_title_state, poplog3_titles,
# title_seasons, poplog3_episodes).
POPLOG_LOCAL_CONTINUE_WATCHING_ENABLED=false
# Ativa a seção "Assistido recentemente" usando dados locais (user_title_state, user_episodes,
# poplog3_titles, poplog3_episodes).
POPLOG_LOCAL_RECENTLY_WATCHED_ENABLED=false
# Ativa a seção "Novos episódios" usando dados locais (user_title_state, poplog3_titles,
# title_seasons, poplog3_episodes).
POPLOG_LOCAL_NEW_EPISODES_ENABLED=false
# Ativa a seção "Picks da watchlist" usando dados locais (user_title_state, poplog3_titles,
# poplog3_episodes, title_ratings). O cache persistente (continuity_section_cache) já é flag-aware.
POPLOG_LOCAL_WATCHLIST_PICKS_ENABLED=false
# Ativa o filtro personalizado do Radar usando user_title_state local.
POPLOG_LOCAL_RADAR_ENABLED=false
# Ativa o enriquecimento de availability/user_state e library da Agenda usando dados locais.
POPLOG_LOCAL_AGENDA_ENABLED=false

# ── Auth local dev ───────────────────────────────────────────────────────────
# Com true: getCurrentUser() usa local-user via LOCAL_USER_ID + Prisma.
# Auth.js não é chamado. Modo dev/smoke apenas — nunca usar em produção.
POPLOG_LOCAL_AUTH_ENABLED=false

# ── Trakt.tv ─────────────────────────────────────────────────────────────────
# Necessário para trending, busca, detalhes públicos, temporadas/episódios e comentários.
TRAKT_CLIENT_ID=
TRAKT_ACTIVE=true
TRAKT_INDEX_ENABLED=true

# ── Auth.js / NextAuth ───────────────────────────────────────────────────────
# AUTH_SECRET é obrigatório para Next Auth inicializar sem erro.
# Em modo local dev, pode ser qualquer string (não usada para login real).
# Em produção, gerar com: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth — configure no Google Cloud Console.
# Callback URL: http://localhost:3000/api/auth/callback/google
# Deixar vazio em modo local dev (POPLOG_LOCAL_AUTH_ENABLED=true).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
