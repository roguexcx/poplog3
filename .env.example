NEXT_PUBLIC_BASE_URL=http://localhost:3000
TMDB_API_KEY=

# Feed de trending/airing do TMDB — mescla com o Banco de Séries
# "true" liga a fonte, qualquer outro valor (ou ausente) desliga
ENABLE_TMDB_TRENDING_FEED=false
WATCHMODE_API_KEY=
MOVIEOFTHENIGHT_API_KEY=
OMDB_API_KEY=
# Logs detalhados da hidratação/duração da Watchlist.
DEBUG_WATCHLIST_HYDRATION=false
# Logs detalhados de disponibilidade/streaming.
DEBUG_AVAILABILITY=false
# Logs detalhados de performance da Biblioteca.
DEBUG_LIBRARY_PERF=false
