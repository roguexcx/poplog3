NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin/internal tools
ADMIN_SECRET=

# Local-first assets/storage. Keep assetKey in DB; only URL/root change per environment.
POPLOG_STORAGE_DRIVER=local
POPLOG_LOCAL_STORAGE_ROOT=./storage
POPLOG_ASSET_PUBLIC_BASE_URL=/storage
NEXT_PUBLIC_POPLOG_ASSET_PUBLIC_BASE_URL=/storage
# Future S3-compatible/CDN storage. Keep empty while POPLOG_STORAGE_DRIVER=local.
POPLOG_S3_ENDPOINT=
POPLOG_S3_REGION=us-east-1
POPLOG_S3_BUCKET=
POPLOG_S3_ACCESS_KEY_ID=
POPLOG_S3_SECRET_ACCESS_KEY=
POPLOG_S3_FORCE_PATH_STYLE=true

# Future monetization foundation. Keep disabled locally unless actively testing.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_ADS_RESERVED_LAYOUT=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BETWEEN_BLOCKS=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_AFTER_RANKINGS=
NEXT_PUBLIC_ADSENSE_SLOT_LIST_BETWEEN_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_TITLE_AFTER_MAIN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_RADAR_BETWEEN_GROUPS=
NEXT_PUBLIC_ADSENSE_SLOT_LIBRARY_BETWEEN_GROUPS=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_CONTEXTUAL=

# Feature flags
NEXT_PUBLIC_FEATURE_RADAR=true
POPLOG_IMAGE_WORKER_CONCURRENCY=2

# TMDB
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
ENABLE_TMDB_TRENDING_FEED=false
RADAR_RETROFILL_MAX_SEASONS=600

# External APIs
WATCHMODE_API_KEY=
MOVIEOFTHENIGHT_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_ACTIVE=true
# Habilita o Trakt Index TOP 50 como fonte primária de trending (padrão: true se TRAKT_ACTIVE=true)
TRAKT_INDEX_ENABLED=true
YOUTUBE_API_KEY=
GOOGLE_API_KEY=

# Balloonerismm — fonte IMDb-first (inativa por padrão)
BALLOONERISMM_ACTIVE=false
BALLOONERISMM_BASE_URL=https://api.balloonerismm.workers.dev
BALLOONERISMM_TIMEOUT_MS=8000
BALLOONERISMM_API_KEY=
CATALOG_SOURCE=legacy
CATALOG_FALLBACK=legacy
BALLOONERISMM_RATINGS_ENABLED=false
BALLOONERISMM_EXTERNAL_IDS_ENABLED=true
BALLOONERISMM_PROVIDERS_ENABLED=false
BALLOONERISMM_PROVIDERS_DEBUG_ONLY=true
BALLOONERISMM_SEARCH_ENABLED=false
BALLOONERISMM_TRENDING_ENABLED=false
BALLOONERISMM_DISCOVER_ENABLED=false

# Providers — JustWatch é protagonista; Balloonerismm fica como fallback residual.
JUSTWATCH_PRIMARY=true
JUSTWATCH_UNOFFICIAL_FALLBACK=false
JUSTWATCH_CHANNEL_ENRICHMENT=true

# Debug and scripts
DEBUG_RADAR=false
DEBUG_WATCHLIST_HYDRATION=false
DEBUG_AVAILABILITY=false
DEBUG_LIBRARY_PERF=false
SMOKE_TEST_USER_ID=

# Prisma/local DB diagnostics. Production can append MySQL params such as
# ?connection_limit=5&pool_timeout=10&connect_timeout=10 to DATABASE_URL.
PRISMA_QUERY_LOGS=false
PRISMA_SLOW_QUERY_MS=350

# Optional Redis cache. Disabled when REDIS_URL is empty; localhost keeps using MySQL cache.
# Local validation: docker compose up -d redis && npm run cache:smoke:redis
REDIS_URL=
POPLOG_REDIS_PREFIX=poplog:v2
POPLOG_REDIS_TIMEOUT_MS=500

POPLOG_WORKER_MAX_CONCURRENCY=2
POPLOG_REFRESH_QUEUE_LOCK_MS=60000
POPLOG_REFRESH_QUEUE_RETRY_DELAY_MS=120000
POPLOG_REFRESH_QUEUE_MAX_ATTEMPTS=5
POPLOG_REFRESH_WORKER_POLL_MS=30000
POPLOG_AVAILABILITY_WARM_LIMIT=12
POPLOG_AVAILABILITY_WARM_CONCURRENCY=2

# Worker cron endpoint. Configure the production scheduler to call:
# POST /api/cron/refresh-workers with Authorization: Bearer $POPLOG_CRON_SECRET
POPLOG_CRON_SECRET=
POPLOG_WORKER_CRON_LIMIT=2
POPLOG_WORKER_CRON_EXPECTED_MS=600000
POPLOG_WORKER_STALE_RUNNING_MS=300000
POPLOG_WORKER_OVERDUE_ALERT_MS=600000
